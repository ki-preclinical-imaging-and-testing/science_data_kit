# Include Python files
recursive-include science_data_kit *.py
recursive-include app *.py

# Include Streamlit configuration files
recursive-include app/.streamlit *

# Include documentation
include README.md
include LICENSE
include INSTALL.md
include CONTRIBUTING.md
include docs/*.md

# Include configuration files
include pyproject.toml
include db_config.template.yaml

# Include scripts
include run_app.py
include verify.py

# Include templates
recursive-include science_data_kit/core/templates *

# Include tests
recursive-include tests *.py

# Include tutorials
recursive-include tutorials *.md
recursive-include tutorials *.py
recursive-include tutorials *.ipynb

# Exclude unnecessary files
global-exclude *.pyc
global-exclude __pycache__
global-exclude .git
global-exclude .gitignore
global-exclude .ipynb_checkpoints
global-exclude *.egg-info
global-exclude *.egg
global-exclude .DS_Store
global-exclude .mypy_cache
global-exclude .pytest_cache
global-exclude .coverage
global-exclude htmlcov
